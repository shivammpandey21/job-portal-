Options -Indexes
<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteRule ^(?:app|config|routes|storage|database|scripts)(?:/|$) - [F,L]
    RewriteRule ^public(?:/|$) - [L]
    RewriteRule ^$ public/ [L]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
<FilesMatch "^\.(env|git)">
    Require all denied
</FilesMatch>
